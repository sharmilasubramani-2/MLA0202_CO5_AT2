Function MonteCarloDeliveryEstimation(NumSimulations, TrafficThreshold)
    Initialize OnTimeCount to 0
    For i = 1 To NumSimulations Do
        Generate RandomSample from UniformDistribution(0, 1)
        If RandomSample <= TrafficThreshold Then
            Set DeliveryStatus to 1
            OnTimeCount = OnTimeCount + 1
        Else
            Set DeliveryStatus to 0
        End If
    End For
    Set EstimatedProbability to OnTimeCount / NumSimulations
    Display EstimatedProbability
End Function
